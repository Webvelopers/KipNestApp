# Run npm run setup to generate .env with a token, or copy this file.
HOST=127.0.0.1
PORT=3000
# Local certificate generated with npm run cert. Paths relative to the project.
TLS_CERT_FILE=certs/local-cert.pem
TLS_KEY_FILE=certs/local-key.pem
# Sizes in MiB (shown as MB in the interface).
MAX_FILE_MB=100
MAX_STORAGE_MB=1024
# Maximum number of stored files (1-1000000).
MAX_FILES=1000
# Allowed receive and idle time for each file, in seconds.
UPLOAD_TIMEOUT_SECONDS=300
# Optional: folder for the encrypted stored files, relative to the project or
# absolute (default storage/uploads). In production, prefer a folder outside the
# project, for example /var/lib/kipnest or C:\ProgramData\KipNest. It must not be
# inside dist/client: the server refuses to start if it is.
# UPLOAD_DIR=storage/uploads
# Optional: save every interaction to disk, one JSON line per request (time,
# action such as sign-in/upload/download/delete, outcome, status, duration,
# client IP; never tokens, keys, or file names) in one file per day
# (kipnest-YYYY-MM-DD.log). Off when empty. Keep it outside dist/client.
# LOG_DIR=storage/logs
# Days to keep log files; older ones are deleted automatically (1-3650).
# LOG_RETENTION_DAYS=30
# Simultaneous uploads allowed (1 keeps the default one-at-a-time behavior).
MAX_CONCURRENT_UPLOADS=1
# Optional: use at least 32 random characters.
# If omitted, a new token is generated at startup and shown in the console.
# UPLOAD_TOKEN=
# Required. Encrypts stored files and their details: 32 random bytes in base64url.
# npm run setup generates it. BACK IT UP: if it is lost, stored files are unreadable.
# STORAGE_KEY=
# Optional, for rotation: previous STORAGE_KEY values (comma-separated) that can
# still decrypt files until npm run encrypt:rotate re-wraps them.
# STORAGE_KEY_PREVIOUS=
# Required. Per-installation salt for the token key: 16 random bytes in base64url (not secret).
# KDF_SALT=
